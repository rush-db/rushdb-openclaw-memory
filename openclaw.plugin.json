{
  "id": "rushdb-memory",
  "name": "RushDB Memory",
  "description": "Additive scope-safe persistent memory backed by RushDB. Keeps OpenClaw local memory active.",
  "uiHints": {
    "apiKey": {
      "label": "RushDB API Key",
      "sensitive": true,
      "placeholder": "Prefer RUSHDB_API_KEY"
    },
    "url": {
      "label": "RushDB API URL",
      "placeholder": "https://api.rushdb.com/api/v1",
      "advanced": true
    },
    "engineUrl": {
      "label": "Standalone Engine URL",
      "placeholder": "Prefer RUSHDB_ENGINE_URL",
      "help": "A standalone RushDB engine instead of RushDB Cloud; needs an embedding provider",
      "advanced": true
    },
    "engineToken": {
      "label": "Standalone Engine Token",
      "sensitive": true,
      "placeholder": "Prefer RUSHDB_ENGINE_TOKEN",
      "advanced": true
    },
    "engineScope": {
      "label": "Standalone Engine Tenant",
      "help": "Only for an engine started with --multitenant",
      "advanced": true
    },
    "embeddingBaseUrl": {
      "label": "Embedding API URL",
      "placeholder": "https://api.openai.com/v1",
      "advanced": true
    },
    "embeddingApiKey": {
      "label": "Embedding API Key",
      "sensitive": true,
      "placeholder": "Prefer RUSHDB_EMBEDDING_API_KEY",
      "advanced": true
    },
    "embeddingModel": {
      "label": "Embedding Model",
      "placeholder": "text-embedding-3-small",
      "advanced": true
    },
    "embeddingDimensions": {
      "label": "Embedding Dimensions",
      "placeholder": "1536",
      "advanced": true
    },
    "profileId": {
      "label": "Memory Profile",
      "placeholder": "default"
    },
    "scopeSalt": {
      "label": "Scope Hash Salt",
      "sensitive": true,
      "placeholder": "Prefer RUSHDB_MEMORY_SCOPE_SALT",
      "advanced": true
    },
    "localScopeId": {
      "label": "Local Cross-Session Scope",
      "help": "Optional stable identifier for cross-session recall in local/CLI conversations",
      "advanced": true
    },
    "outboxPath": {
      "label": "Durable Outbox Path",
      "placeholder": "~/.openclaw/rushdb-memory/outbox",
      "advanced": true
    },
    "autoRecall": {
      "label": "Automatic Recall"
    },
    "autoCapture": {
      "label": "Automatic Capture"
    },
    "recallTimeoutMs": {
      "label": "Recall Timeout (ms)",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string"
      },
      "url": {
        "type": "string"
      },
      "engineUrl": {
        "type": "string"
      },
      "engineToken": {
        "type": "string"
      },
      "engineScope": {
        "type": "string"
      },
      "embeddingBaseUrl": {
        "type": "string"
      },
      "embeddingApiKey": {
        "type": "string"
      },
      "embeddingModel": {
        "type": "string"
      },
      "embeddingDimensions": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096
      },
      "profileId": {
        "type": "string",
        "minLength": 1
      },
      "scopeSalt": {
        "type": "string"
      },
      "localScopeId": {
        "type": "string"
      },
      "outboxPath": {
        "type": "string"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "recallTimeoutMs": {
        "type": "integer",
        "minimum": 50,
        "maximum": 30000
      }
    }
  }
}
